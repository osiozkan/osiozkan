    "postinstall": "node scripts/patch-fengari.mjs"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "fengari": "^0.1.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
