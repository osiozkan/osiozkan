{
  "name": "yoru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Yoru — anime subtitle editor: Aegisub-compatible (ASS + Lua automation) with Subtitle Edit's QC/conversion tooling.",
